    "    print(\"Wallet Error:\", e)\n",
    "\n",
    "except TransferLimitExceeded as e:\n",
    "    print(\"Wallet Error:\", e)\n",
    "\n",
    "except ValueError:\n",
    "    print(\"Invalid input! Please enter a valid amount.\")"
