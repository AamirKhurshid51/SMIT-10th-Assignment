    "class ProductNotFound(Exception):\n",
    "    pass\n",
    "\n",
    "\n",
    "class InvalidQuantity(Exception):\n",
    "    pass\n",
    "\n",
    "\n",
    "class InsufficientStock(Exception):\n",
    "    pass\n",
    "\n",
    "\n",
    "class RetailInventory:\n",
    "\n",
    "    def __init__(self):\n",
    "        self.inventory = {\n",
    "            \"Laptop\": {\"price\": 80000, \"stock\": 5},\n",
    "            \"Mobile\": {\"price\": 40000, \"stock\": 10},\n",
    "            \"Headphones\": {\"price\": 3000, \"stock\": 8}\n",
    "        }\n",
    "\n",
    "    def add_stock(self, product, quantity):\n",
    "\n",
    "        if product not in self.inventory:\n",
    "            raise ProductNotFound(\"Product does not exist.\")\n",
    "\n",
    "        if quantity <= 0:\n",
    "            raise InvalidQuantity(\"Quantity must be greater than zero.\")\n",
    "\n",
    "        self.inventory[product][\"stock\"] += quantity\n",
    "\n",
    "        print(\"Stock added successfully!\")\n",
    "\n",
    "    def view_inventory(self):\n",
    "\n",
    "        print(\"\\n----- INVENTORY -----\")\n",
    "\n",
    "        for product, details in self.inventory.items():\n",
    "            print(\"Product:\", product)\n",
    "            print(\"Price: Rs.\", details[\"price\"])\n",
    "            print(\"Stock:\", details[\"stock\"])\n",
    "            print(\"--------------------\")\n",
    "\n",
    "    def sell_product(self, product, quantity):\n",
    "\n",
    "        if product not in self.inventory:\n",
    "            raise ProductNotFound(\"Product does not exist.\")\n",
    "\n",
    "        if quantity <= 0:\n",
    "            raise InvalidQuantity(\"Quantity must be greater than zero.\")\n",
    "\n",
    "        if quantity > self.inventory[product][\"stock\"]:\n",
    "            raise InsufficientStock(\"Not enough stock available.\")\n",
    "\n",
    "        total = self.inventory[product][\"price\"] * quantity\n",
    "\n",
    "        self.inventory[product][\"stock\"] -= quantity\n",
    "\n",
    "        print(\"\\nSale Successful!\")\n",
    "        print(\"Product:\", product)\n",
    "        print(\"Quantity:\", quantity)\n",
    "        print(\"Total Bill: Rs.\", total)\n",
    "\n",
    "    def search_product(self, product):\n",
    "\n",
    "        if product not in self.inventory:\n",
    "            raise ProductNotFound(\"Product does not exist.\")\n",
    "\n",
    "        print(\"\\nProduct Found!\")\n",
    "        print(\"Name:\", product)\n",
    "        print(\"Price: Rs.\", self.inventory[product][\"price\"])\n",
    "        print(\"Available Stock:\", self.inventory[product][\"stock\"])\n",
    "\n",
    "\n",
    "# Main Program\n",
    "\n",
    "shop = RetailInventory()\n",
    "\n",
    "while True:\n",
    "\n",
    "    print(\"\\n===== RETAIL INVENTORY SYSTEM =====\")\n",
    "    print(\"1. Add Stock\")\n",
    "    print(\"2. View Inventory\")\n",
    "    print(\"3. Sell Product\")\n",
    "    print(\"4. Search Product\")\n",
    "    print(\"5. Exit\")\n",
    "\n",
    "    try:\n",
    "        choice = int(input(\"\\nEnter your choice: \"))\n",
    "\n",
    "        if choice == 1:\n",
    "\n",
    "            product = input(\"Enter product name: \").title()\n",
    "            quantity = int(input(\"Enter quantity to add: \"))\n",
    "\n",
    "            shop.add_stock(product, quantity)\n",
    "\n",
    "        elif choice == 2:\n",
    "\n",
    "            shop.view_inventory()\n",
    "\n",
    "        elif choice == 3:\n",
    "\n",
    "            product = input(\"Enter product name: \").title()\n",
    "            quantity = int(input(\"Enter quantity to sell: \"))\n",
    "\n",
    "            shop.sell_product(product, quantity)\n",
    "\n",
    "        elif choice == 4:\n",
    "\n",
    "            product = input(\"Enter product name: \").title()\n",
    "\n",
    "            shop.search_product(product)\n",
    "\n",
    "        elif choice == 5:\n",
    "\n",
    "            print(\"Thank you for using the system!\")\n",
    "            break\n",
    "\n",
    "        else:\n",
    "            print(\"Invalid choice! Please select 1 to 5.\")\n",
    "\n",
    "    except ProductNotFound as e:\n",
    "        print(\"Error:\", e)\n",
    "\n",
    "    except InvalidQuantity as e:\n",
    "        print(\"Error:\", e)\n",
    "\n",
    "    except InsufficientStock as e:\n",
    "        print(\"Error:\", e)\n",
    "\n",
    "    except ValueError:\n",
    "        print(\"Invalid input! Please enter a valid number.\")\n",
    "\n",
    "    else:\n",
    "        print(\"Operation completed successfully.\")\n",
    "\n",
    "    finally:\n",
    "        print(\"Inventory System Operation Finished.\")"
   ]
