    "class InvalidWalletID(Exception):\n",
    "    pass\n",
    "\n",
    "\n",
    "class InvalidPIN(Exception):\n",
    "    pass\n",
    "\n",
    "\n",
    "class InactiveAccount(Exception):\n",
    "    pass\n",
    "\n",
    "\n",
    "class InvalidAmount(Exception):\n",
    "    pass\n",
    "\n",
    "\n",
    "class InsufficientBalance(Exception):\n",
    "    pass\n",
    "\n",
    "\n",
    "class TransferLimitExceeded(Exception):\n",
    "    pass\n",
    "\n",
    "\n",
    "class DigitalWallet:\n",
    "\n",
    "    def __init__(self):\n",
    "        self.wallets = {\n",
    "            \"W101\": {\n",
    "                \"pin\": \"1234\",\n",
    "                \"balance\": 10000,\n",
    "                \"active\": True\n",
    "            },\n",
    "\n",
    "            \"W102\": {\n",
    "                \"pin\": \"5678\",\n",
    "                \"balance\": 5000,\n",
    "                \"active\": True\n",
    "            },\n",
    "\n",
    "            \"W103\": {\n",
    "                \"pin\": \"9999\",\n",
    "                \"balance\": 3000,\n",
    "                \"active\": False\n",
    "            }\n",
    "        }\n",
    "\n",
    "        self.transfer_limit = 5000\n",
    "\n",
    "    def transfer(self, sender_id, pin, receiver_id, amount):\n",
    "\n",
    "        # Check sender wallet\n",
    "        if sender_id not in self.wallets:\n",
    "            raise InvalidWalletID(\"Sender wallet does not exist.\")\n",
    "\n",
    "        # Check receiver wallet\n",
    "        if receiver_id not in self.wallets:\n",
    "            raise InvalidWalletID(\"Receiver wallet does not exist.\")\n",
    "\n",
    "        # Validate PIN\n",
    "        if self.wallets[sender_id][\"pin\"] != pin:\n",
    "            raise InvalidPIN(\"Incorrect wallet PIN.\")\n",
    "\n",
    "        # Check account status\n",
    "        if not self.wallets[sender_id][\"active\"]:\n",
    "            raise InactiveAccount(\"Sender account is inactive.\")\n",
    "\n",
    "        if not self.wallets[receiver_id][\"active\"]:\n",
    "            raise InactiveAccount(\"Receiver account is inactive.\")\n",
    "\n",
    "        # Validate transfer amount\n",
    "        if amount <= 0:\n",
    "            raise InvalidAmount(\"Transfer amount must be greater than zero.\")\n",
    "\n",
    "        # Check transfer limit\n",
    "        if amount > self.transfer_limit:\n",
    "            raise TransferLimitExceeded(\"Transfer limit is Rs. 5000.\")\n",
    "\n",
    "        # Check balance\n",
    "        if amount > self.wallets[sender_id][\"balance\"]:\n",
    "            raise InsufficientBalance(\"Insufficient wallet balance.\")\n",
    "\n",
    "        # Update balances after all checks pass\n",
    "        self.wallets[sender_id][\"balance\"] -= amount\n",
    "        self.wallets[receiver_id][\"balance\"] += amount\n",
    "\n",
    "        print(\"\\nTransfer Successful!\")\n",
    "        print(\"Transferred Amount: Rs.\", amount)\n",
    "        print(\"Sender Balance: Rs.\", self.wallets[sender_id][\"balance\"])\n",
    "        print(\"Receiver Balance: Rs.\", self.wallets[receiver_id][\"balance\"])\n",
    "\n",
    "\n",
    "try:\n",
    "    wallet = DigitalWallet()\n",
    "\n",
    "    print(\"Available Wallets: W101, W102, W103\")\n",
    "\n",
    "    sender_id = input(\"Enter Sender Wallet ID: \").upper()\n",
    "    pin = input(\"Enter PIN: \")\n",
    "    receiver_id = input(\"Enter Receiver Wallet ID: \").upper()\n",
    "    amount = float(input(\"Enter Transfer Amount: \"))\n",
    "\n",
    "    wallet.transfer(sender_id, pin, receiver_id, amount)\n",
    "\n",
    "except InvalidWalletID as e:\n",
    "    print(\"Wallet Error:\", e)\n",
    "\n",
    "except InvalidPIN as e:\n",
    "    print(\"Wallet Error:\", e)\n",
    "\n",
    "except InactiveAccount as e:\n",
    "    print(\"Wallet Error:\", e)\n",
    "\n",
