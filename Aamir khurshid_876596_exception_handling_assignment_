    "\n",
    "# Food Delivery Application\n",
    "\n",
    "# Custom Exception Classes\n",
    "\n",
    "class InvalidCustomer(Exception):\n",
    "    pass\n",
    "\n",
    "class InvalidRestaurant(Exception):\n",
    "    pass\n",
    "\n",
    "class OutOfStock(Exception):\n",
    "    pass\n",
    "\n",
    "class MinimumOrderError(Exception):\n",
    "    pass\n",
    "\n",
    "class InvalidDeliveryArea(Exception):\n",
    "    pass\n",
    "\n",
    "class InsufficientBalance(Exception):\n",
    "    pass\n",
    "\n",
    "\n",
    "# Application Data\n",
    "\n",
    "restaurants = {\n",
    "    \"ABC Foods\": {\n",
    "        \"Burger\": {\"price\": 500, \"stock\": 10},\n",
    "        \"Pizza\": {\"price\": 1200, \"stock\": 5},\n",
    "        \"Fries\": {\"price\": 200, \"stock\": 15}\n",
    "    },\n",
    "    \"Fast Food\": {\n",
    "        \"Burger\": {\"price\": 450, \"stock\": 8},\n",
    "        \"Biryani\": {\"price\": 350, \"stock\": 10},\n",
    "        \"Cold Drink\": {\"price\": 150, \"stock\": 20}\n",
    "    }\n",
    "}\n",
    "\n",
    "delivery_areas = [\"Karachi\", \"Lahore\", \"Islamabad\"]\n",
    "\n",
    "minimum_order = 500\n",
    "\n",
    "balance = 10000\n",
    "\n",
    "\n",
    "try:\n",
    "    # Customer Registration\n",
    "\n",
    "    customer = input(\"Enter customer name: \")\n",
    "\n",
    "    if customer.strip() == \"\":\n",
    "        raise InvalidCustomer(\"Customer name cannot be empty!\")\n",
    "\n",
    "    print(\"\\nCustomer registered successfully!\")\n",
    "\n",
    "    # Restaurant Selection\n",
    "\n",
    "    print(\"\\nAvailable Restaurants:\")\n",
    "\n",
    "    for restaurant in restaurants:\n",
    "        print(\"-\", restaurant)\n",
    "\n",
    "    selected_restaurant = input(\"\\nSelect restaurant: \")\n",
    "\n",
    "    if selected_restaurant not in restaurants:\n",
    "        raise InvalidRestaurant(\"Restaurant not found!\")\n",
    "\n",
    "    menu = restaurants[selected_restaurant]\n",
    "\n",
    "    # Display Menu\n",
    "\n",
    "    print(\"\\n----- MENU -----\")\n",
    "\n",
    "    for item, details in menu.items():\n",
    "        print(item, \"- Rs.\", details[\"price\"],\n",
    "              \"- Stock:\", details[\"stock\"])\n",
    "\n",
    "    # Select Food Item\n",
    "\n",
    "    selected_item = input(\"\\nEnter food item: \")\n",
    "\n",
    "    if selected_item not in menu:\n",
    "        raise ValueError(\"Food item not available!\")\n",
    "\n",
    "    quantity = int(input(\"Enter quantity: \"))\n",
    "\n",
    "    if quantity <= 0:\n",
    "        raise ValueError(\"Quantity must be greater than zero!\")\n",
    "\n",
    "    # Stock Validation\n",
    "\n",
    "    if quantity > menu[selected_item][\"stock\"]:\n",
    "        raise OutOfStock(\"Sorry! Not enough stock available.\")\n",
    "\n",
    "    # Calculate Bill\n",
    "\n",
    "    price = menu[selected_item][\"price\"]\n",
    "    total = price * quantity\n",
    "\n",
    "    print(\"\\nTotal Amount: Rs.\", total)\n",
    "\n",
    "    # Minimum Order Validation\n",
    "\n",
    "    if total < minimum_order:\n",
    "        raise MinimumOrderError(\n",
    "            \"Minimum order amount is Rs. 500!\"\n",
    "        )\n",
    "\n",
    "    # Delivery Area Validation\n",
    "\n",
    "    print(\"\\nAvailable Delivery Areas:\")\n",
    "\n",
    "    for area in delivery_areas:\n",
    "        print(\"-\", area)\n",
    "\n",
    "    area = input(\"\\nEnter delivery area: \")\n",
    "\n",
    "    if area not in delivery_areas:\n",
    "        raise InvalidDeliveryArea(\"Delivery area not available!\")\n",
    "\n",
    "    # Payment Processing\n",
    "\n",
    "    print(\"\\nAvailable Balance: Rs.\", balance)\n",
    "\n",
    "    if total > balance:\n",
    "        raise InsufficientBalance(\"Insufficient payment balance!\")\n",
    "\n",
    "    payment = input(\"Confirm payment? (yes/no): \")\n",
    "\n",
    "    if payment.lower() != \"yes\":\n",
    "        raise ValueError(\"Payment cancelled!\")\n",
    "\n",
    "    # Update Data Only After All Validations\n",
    "\n",
    "    balance -= total\n",
    "    menu[selected_item][\"stock\"] -= quantity\n",
    "\n",
    "except InvalidCustomer as e:\n",
    "    print(\"Customer Error:\", e)\n",
    "\n",
    "except InvalidRestaurant as e:\n",
    "    print(\"Restaurant Error:\", e)\n",
    "\n",
    "except OutOfStock as e:\n",
    "    print(\"Stock Error:\", e)\n",
    "\n",
    "except MinimumOrderError as e:\n",
    "    print(\"Order Error:\", e)\n",
    "\n",
    "except InvalidDeliveryArea as e:\n",
    "    print(\"Delivery Error:\", e)\n",
    "\n",
    "except InsufficientBalance as e:\n",
    "    print(\"Payment Error:\", e)\n",
    "\n",
    "except ValueError as e:\n",
    "    print(\"Input Error:\", e)\n",
    "\n",
    "except Exception as e:\n",
    "    print(\"Unexpected Error:\", e)\n",
    "\n",
    "else:\n",
    "    print(\"\\n========== ORDER CONFIRMED ==========\")\n",
    "    print(\"Customer:\", customer)\n",
    "    print(\"Restaurant:\", selected_restaurant)\n",
    "    print(\"Food Item:\", selected_item)\n",
    "    print(\"Quantity:\", quantity)\n",
    "    print(\"Delivery Area:\", area)\n",
    "    print(\"Total Bill: Rs.\", total)\n",
    "    print(\"Payment: Successful\")\n",
    "    print(\"Order placed successfully!\")\n",
    "\n",
    "finally:\n",
    "    print(\"\\nThank you for using Food Delivery Application!\")\n"
