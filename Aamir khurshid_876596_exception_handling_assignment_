    "            )\n",
    "\n",
    "        self.balance -= amount\n",
    "        print(\"Amount withdrawn successfully!\")\n",
    "\n",
    "    def show_balance(self):\n",
    "        print(\"Current Balance: Rs.\", self.balance)\n",
    "\n",
    "\n",
