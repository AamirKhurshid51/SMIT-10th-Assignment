    "class InvalidTransactionAmount(Exception):\n",
    "    pass\n",
    "\n",
    "\n",
    "class InsufficientBalance(Exception):\n",
    "    pass\n",
    "\n",
    "\n",
    "class BankAccount:\n",
    "\n",
    "    def __init__(self, balance):\n",
    "        self.balance = balance\n",
    "\n",
    "    def deposit(self, amount):\n",
    "        if amount <= 0:\n",
    "            raise InvalidTransactionAmount(\n",
