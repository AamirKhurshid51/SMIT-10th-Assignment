    "            102: \"Ahmed\",\n",
    "            103: \"Sara\"\n",
    "        }\n",
    "\n",
    "        self.courses = {\n",
    "            \"Python\": {\n",
    "                \"capacity\": 2,\n",
    "                \"registered\": [],\n",
    "                \"prerequisite\": None\n",
    "            },\n",
    "\n",
    "            \"OOP\": {\n",
    "                \"capacity\": 2,\n",
    "                \"registered\": [],\n",
    "                \"prerequisite\": \"Python\"\n",
    "            },\n",
    "\n",
    "            \"Database\": {\n",
    "                \"capacity\": 3,\n",
    "                \"registered\": [],\n",
    "                \"prerequisite\": None\n",
    "            }\n",
    "        }\n",
    "\n",
    "        self.completed_courses = {\n",
    "            101: [\"Python\"],\n",
    "            102: [],\n",
    "            103: [\"Python\"]\n",
    "        }\n",
    "\n",
    "    def register_course(self, student_id, course):\n",
    "\n",
    "        if student_id not in self.students:\n",
    "            raise StudentNotFound(\"Student does not exist.\")\n",
    "\n",
    "        if course not in self.courses:\n",
    "            raise CourseNotFound(\"Course does not exist.\")\n",
    "\n",
    "        if student_id in self.courses[course][\"registered\"]:\n",
    "            raise DuplicateRegistration(\n",
    "                \"Student is already registered in this course.\"\n",
    "            )\n",
    "\n",
    "        if len(self.courses[course][\"registered\"]) >= self.courses[course][\"capacity\"]:\n",
    "            raise CourseFull(\"Course capacity is full.\")\n",
    "\n",
    "        prerequisite = self.courses[course][\"prerequisite\"]\n",
    "\n",
    "        if prerequisite is not None:\n",
    "            if prerequisite not in self.completed_courses.get(student_id, []):\n",
    "                raise PrerequisiteNotCompleted(\n",
    "                    \"Prerequisite course is not completed.\"\n",
    "                )\n",
    "\n",
    "        self.courses[course][\"registered\"].append(student_id)\n",
    "\n",
    "        print(\"\\nRegistration Successful!\")\n",
